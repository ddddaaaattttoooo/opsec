    printf "${RED}"
    cat << 'EOF'

  ▒█████   ██▓███    ██████ ▓█████  ▄████▄  
 ▒██▒  ██▒▓██░  ██▒▒██    ▒ ▓█   ▀ ▒██▀ ▀█  
 ▒██░  ██▒▓██░ ██▓▒░ ▓██▄   ▒███   ▒▓█    ▄ 
 ▒██   ██░▒██▄█▓▒ ▒  ▒   ██▒▒▓█  ▄ ▒▓▓▄ ▄██▒
 ░ ████▓▒░▒██▒ ░  ░▒██████▒▒░▒████▒▒ ▓███▀ ░
 ░ ▒░▒░▒░ ▒▓▒░ ░  ░▒ ▒▓▒ ▒ ░░░ ▒░ ░░ ░▒ ▒  ░
   ░ ▒ ▒░ ░▒ ░     ░ ░▒  ░ ░ ░ ░  ░  ░  ▒   
