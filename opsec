#!/bin/sh
# opsec - become sinister
# Works on any POSIX system (Linux, macOS, BSD, etc.)

VERSION="1.2.5"

ESC=$(printf '\033')
RED="${ESC}[0;31m"
GREEN="${ESC}[0;32m"
YELLOW="${ESC}[1;33m"
CYAN="${ESC}[0;36m"
BOLD="${ESC}[1m"
RESET="${ESC}[0m"

typewriter() {
    text="$1"
    delay="${2:-0.018}"
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import sys, time, re
text = sys.argv[1].replace("\\n", "\n").replace("\\t", "\t")
delay = float(sys.argv[2])
pattern = re.compile(r"(\x1b\[[0-9;]*[a-zA-Z]|\r|\n|.)")
for token in pattern.findall(text):
    sys.stdout.write(token)
    sys.stdout.flush()
    if not (token.startswith("\x1b") or token in ("\r", "\n")):
        time.sleep(delay)
sys.stdout.write("\n")
sys.stdout.flush()
' "$text" "$delay"
    elif command -v perl >/dev/null 2>&1; then
        perl -MTime::HiRes=usleep -e '
use strict;
my $text = $ARGV[0];
$text =~ s/\\n/\n/g;
$text =~ s/\\t/\t/g;
my $delay = ($ARGV[1] || 0.018) * 1_000_000;
while ($text =~ /(\e\[[0-9;]*[a-zA-Z]|\r|\n|.)/gs) {
    print $1;
    select()->flush();
    usleep($delay) unless ($1 =~ /^\e/ || $1 eq "\n" || $1 eq "\r");
}
print "\n";
' "$text" "$delay"
    else
        printf "%b\n" "$text"
    fi
}

