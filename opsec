#!/bin/sh
# opsec - become sinister
# Works on any POSIX system (Linux, macOS, BSD, etc.)

VERSION="1.2.0"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

