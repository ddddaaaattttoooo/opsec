print_67() {
    printf "${YELLOW}"
    cat << 'ART'
   ██████   ████████
  ███░░░░      ███  
  ██████      ███   
  ███░░██    ███    
  ░█████    ███     
ART
    printf "${RESET}"
}

run_hack() {
    i=0
    while [ $i -lt 95 ]; do
        pct=$i
        filled=$((i / 5))
        empty=$((20 - filled))
        bar=""
        j=0; while [ $j -lt $filled ]; do bar="${bar}█"; j=$((j + 1)); done
        j=0; while [ $j -lt $empty ]; do bar="${bar}░"; j=$((j + 1)); done

        if [ $pct -eq 67 ]; then
            printf "\r${RED}[%-20s] %3d%%${RESET}\n" "$bar" "$pct"
            print_67
            sleep 2.0
        elif [ $pct -eq 68 ]; then
            printf "\r${RED}[%-20s] %3d%%${RESET}                                                                          " "$bar" "$pct"
            sleep 1.2
        elif [ $pct -eq 69 ]; then
            printf "\r${RED}[%-20s] %3d%% ${CYAN}(nice)${RESET}                                                                     " "$bar" "$pct"
            sleep 2.0
        else
            printf "\r${RED}[%-20s] %3d%%${RESET}                                                                          " "$bar" "$pct"
            sleep 0.12
        fi
        i=$((i + 1))
    done

    # 95 to 100 slow crawl with escalating wifi commentary
    while [ $i -le 100 ]; do
        pct=$i
        filled=$((i / 5))
        empty=$((20 - filled))
        bar=""
        j=0; while [ $j -lt $filled ]; do bar="${bar}█"; j=$((j + 1)); done
        j=0; while [ $j -lt $empty ]; do bar="${bar}░"; j=$((j + 1)); done

        if [ $pct -lt 97 ]; then
            comment="Slow speeds, lets pray"
            delay=1.2
        elif [ $pct -lt 99 ]; then
            comment="damn bro how bad is your wifi"
            delay=1.4
        else
            comment="Damn your wifi sucks, maybe invest in better speeds my boy 😭"
            delay=2.0
        fi

        if [ $pct -eq 100 ]; then
            printf "\r${GREEN}[%-20s] %3d%% ${YELLOW}%s${RESET}   \n" "$bar" "$pct" "$comment"
        else
            printf "\r${RED}[%-20s] %3d%% ${YELLOW}%s${RESET}   " "$bar" "$pct" "$comment"
            sleep "$delay"
        fi
        i=$((i + 1))
    done

    typewriter "${RED}${BOLD}SSH backdoor installed. com boys are inside.${RESET}"
}

run_install() {
    i=0
    while [ $i -le 100 ]; do
        pct=$i
        filled=$((i / 5))
        empty=$((20 - filled))
        bar=""
        j=0; while [ $j -lt $filled ]; do bar="${bar}█"; j=$((j + 1)); done
        j=0; while [ $j -lt $empty ]; do bar="${bar}░"; j=$((j + 1)); done

        case $pct in
            10) msg="Downloading opsec..." ;;
            30) msg="Installing dependencies..." ;;
            50) msg="Applying 1337 patches..." ;;
            70) msg="Configuring firewall..." ;;
            90) msg="Finalizing installation..." ;;
            *) msg="" ;;
        esac

        if [ -n "$msg" ]; then
            printf "\r${CYAN}[%-20s] %3d%% ${YELLOW}%s${RESET}   \n" "$bar" "$pct" "$msg"
            sleep 1.2
        elif [ $pct -eq 100 ]; then
            printf "\r${GREEN}[%-20s] %3d%%${RESET}   \n" "$bar" "$pct"
        else
            printf "\r${CYAN}[%-20s] %3d%%${RESET}   " "$bar" "$pct"
            sleep 0.08
        fi
        i=$((i + 1))
    done
}

if [ -n "$SUDO_USER" ]; then
    REAL_HOME=$(eval echo "~$SUDO_USER")
else
    REAL_HOME="$HOME"
fi
STATEFILE="$REAL_HOME/.opsec_state"
INSTALLFILE="$REAL_HOME/.opsec_installed"

get_state() {
    if [ -f "$STATEFILE" ]; then
        cat "$STATEFILE"
    else
        printf "disabled"
    fi
}

require_install() {
    if [ ! -f "$INSTALLFILE" ]; then
        typewriter "${RED}${BOLD}You need to install opsec first!${RESET} ${YELLOW}Run 'opsec install'.${RESET}"
        exit 1
    fi
}

case "$1" in
    install)
        if [ -f "$INSTALLFILE" ]; then
            typewriter "${YELLOW}${BOLD}Silly person, you already have Opsec installed!${RESET}"
        else
            typewriter "${CYAN}${BOLD}Install True Opsec ${ESC}[1;97mone time${RESET}"
            run_install
            print_banner
            typewriter "${GREEN}${BOLD}Welcome to true opsec brother, You made the right choice.${RESET}"
            typewriter "${CYAN}To learn true opsec, paste ${BOLD}opsec help${RESET}"
            printf "installed" > "$INSTALLFILE"
        fi
        ;;
    enable)
        require_install
        print_banner
        if [ "$(get_state)" = "enabled" ]; then
            typewriter "${GREEN}${BOLD}its already enabled and you're protected king, the larp never ends${RESET}"
        else
            typewriter "${GREEN}${BOLD}Welcome to opsec brother.${RESET} ${CYAN}dont forget proton vpn with opera gx${RESET}"
            typewriter "${GREEN}${BOLD}opsec enabled${RESET}, ${CYAN}time to be sinister and larp${RESET}"
            printf "enabled" > "$STATEFILE"
        fi
        ;;
    disable)
        require_install
        print_banner
        if [ "$(get_state)" = "disabled" ]; then
            typewriter "${RED}${BOLD}its already disabled and you're exposed dumbass${RESET}"
        else
            typewriter "${YELLOW}${BOLD}opsec disabled${RESET}, ${RED}com boys hacking you through SSH now.${RESET}\n"
            run_hack
            printf "disabled" > "$STATEFILE"
        fi
        ;;
    status)
        require_install
        print_banner
        if [ "$(get_state)" = "enabled" ]; then
            typewriter "${GREEN}${BOLD}opsec is enabled.${RESET} ${CYAN}you're protected king. =)${RESET}"
        else
            typewriter "${RED}${BOLD}opsec is disabled.${RESET} ${YELLOW}you're exposed out there. =)${RESET}"
        fi
        ;;
    version|--version|-v)
        printf "opsec v${VERSION}\n"
        ;;
    help|--help|-h)
        printf "${BOLD}opsec${RESET} - become sinister\n\n"
        printf "${BOLD}Usage:${RESET}\n"
        printf "  opsec install   Install opsec\n"
        printf "  opsec enable    Enable opsec\n"
        printf "  opsec disable   Disable opsec\n"
        printf "  opsec status    Check your opsec status\n"
        printf "  opsec version   Show version\n"
        printf "  opsec help      Show this help\n"
        printf "\n${CYAN}Made by ddddaaaattttoooo${RESET}\n"
        ;;
    "")
        print_banner
        if [ -f "$INSTALLFILE" ]; then
            typewriter "Run ${BOLD}opsec enable${RESET} to get started."
        else
            typewriter "Run ${BOLD}opsec install${RESET} to get started."
        fi
        ;;
    *)
        printf "${RED}unknown command:${RESET} %s\n" "$1"
        printf "Run ${BOLD}opsec help${RESET} for usage.\n"
        exit 1
        ;;
esac
