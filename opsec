    printf "${RESET}"
}

run_hack() {
    i=0
    while [ $i -lt 97 ]; do
        pct=$i
        filled=$((i / 5))
        empty=$((20 - filled))
        bar=""
        j=0; while [ $j -lt $filled ]; do bar="${bar}█"; j=$((j + 1)); done
        j=0; while [ $j -lt $empty ]; do bar="${bar}░"; j=$((j + 1)); done

        if [ $pct -eq 67 ]; then
            printf "\r${RED}[%-20s] %3d%% ${YELLOW}[ 67 ]${RESET}                                   " "$bar" "$pct"
            sleep 1.4
        elif [ $pct -eq 68 ]; then
            printf "\r${RED}[%-20s] %3d%%${RESET}                                          " "$bar" "$pct"
            sleep 0.9
        elif [ $pct -eq 69 ]; then
            printf "\r${RED}[%-20s] %3d%% ${CYAN}(nice)${RESET}                                   " "$bar" "$pct"
            sleep 1.8
        else
            printf "\r${RED}[%-20s] %3d%%${RESET}                                          " "$bar" "$pct"
            sleep 0.025
        fi
        i=$((i + 1))
    done

    # 97 to 100 slow crawl with wifi comment
    while [ $i -le 100 ]; do
        pct=$i
        filled=$((i / 5))
        empty=$((20 - filled))
        bar=""
        j=0; while [ $j -lt $filled ]; do bar="${bar}█"; j=$((j + 1)); done
        j=0; while [ $j -lt $empty ]; do bar="${bar}░"; j=$((j + 1)); done

        if [ $pct -eq 100 ]; then
            printf "\r${GREEN}[%-20s] %3d%% ${YELLOW}(Get better wifi next time bud.)${RESET}\n" "$bar" "$pct"
        else
            printf "\r${RED}[%-20s] %3d%% ${YELLOW}(Get better wifi next time bud.)${RESET}" "$bar" "$pct"
            if [ $pct -eq 99 ]; then
                sleep 1.6
            else
                sleep 1.2
            fi
        fi
        i=$((i + 1))
    done

    printf "${RED}${BOLD}SSH backdoor installed. com boys are inside.${RESET}\n"
}

if [ -n "$SUDO_USER" ]; then
    REAL_HOME=$(eval echo "~$SUDO_USER")
else
    REAL_HOME="$HOME"
fi
STATEFILE="$REAL_HOME/.opsec_state"

get_state() {
    if [ -f "$STATEFILE" ]; then
        cat "$STATEFILE"
    else
        printf "disabled"
    fi
}

case "$1" in
    enable)
        if [ "$(get_state)" = "enabled" ]; then
            printf "${GREEN}${BOLD}its already enabled and you're protected king, the larp never ends${RESET}\n"
        else
            print_banner
            printf "${GREEN}${BOLD}Welcome to opsec brother.${RESET} ${CYAN}dont forget proton vpn with opera gx${RESET}\n"
            printf "${GREEN}${BOLD}opsec enabled${RESET}, ${CYAN}time to be sinister and larp${RESET}\n"
            printf "enabled" > "$STATEFILE"
        fi
        ;;
    disable)
        if [ "$(get_state)" = "disabled" ]; then
            printf "${RED}${BOLD}its already disabled and you're exposed dumbass${RESET}\n"
        else
            print_banner
            printf "${YELLOW}${BOLD}opsec disabled${RESET}, ${RED}com boys hacking you through SSH now.${RESET}\n\n"
            run_hack
            printf "disabled" > "$STATEFILE"
        fi
        ;;
    status)
        if [ "$(get_state)" = "enabled" ]; then
            printf "${GREEN}${BOLD}opsec is enabled.${RESET} ${CYAN}you're protected king.${RESET}\n"
        else
            printf "${RED}${BOLD}opsec is disabled.${RESET} ${YELLOW}you're exposed out there.${RESET}\n"
        fi
        ;;
    version|--version|-v)
        printf "opsec v${VERSION}\n"
        ;;
    help|--help|-h)
        printf "${BOLD}opsec${RESET} - become sinister\n\n"
        printf "${BOLD}Usage:${RESET}\n"
        printf "  opsec enable    Enable opsec mode\n"
        printf "  opsec disable   Disable opsec mode\n"
        printf "  opsec status    Check your opsec status\n"
        printf "  opsec version   Show version\n"
        printf "  opsec help      Show this help\n"
        printf "\n${CYAN}Made by ddddaaaattttoooo${RESET}\n"
        ;;
    "")
        print_banner
        printf "Run ${BOLD}opsec enable${RESET} to get started.\n"
        ;;
    *)
        printf "${RED}unknown command:${RESET} %s\n" "$1"
        printf "Run ${BOLD}opsec help${RESET} for usage.\n"
        exit 1
        ;;
esac
